# =============================================================================
# Enterprise Advanced RAG / Kubernetes SRE Copilot — Environment Configuration
# =============================================================================
#
# Environment Mode:
#   APP_ENV=development   # Local dev mode (convenient SQLite/default creds allowed)
#   APP_ENV=production    # Production mode (requires explicit POSTGRES_PASSWORD/POSTGRES_DSN)
APP_ENV=development
#
# FREE-FIRST OPTIONS:
#
# Option A — Hosted Free Tier (Recommended Default):
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_your_free_groq_api_key_here
#   RETRIEVAL_BACKEND=fastembed
#   -> Uses Groq's high-speed free tier for inference + FastEmbed on local CPU.
#
# Option B — 100% Local AI (No Cloud Keys, Private):
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.2
#   RETRIEVAL_BACKEND=fastembed
#   -> Requires running Ollama locally (`ollama serve` & `ollama run llama3.2`).
#
# Option C — Deterministic Offline Mode (Zero Models):
#   LLM_PROVIDER=offline
#   RETRIEVAL_BACKEND=fastembed  (or keyword)
#   -> Quoting answers directly from retrieved runbooks with pure BM25 search.
# =============================================================================

# ---------- LLM Provider Selection ----------
# groq | ollama | offline | anthropic | gemini
LLM_PROVIDER=groq

# ---------- Groq Settings (Default Hosted Provider) ----------
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---------- Ollama Settings (Optional Local LLM) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30.0

# ---------- Optional Paid LLM Providers ----------
# Anthropic
ANTHROPIC_API_KEY=
# Google Gemini (Google AI Studio)
GEMINI_API_KEY=

# Common LLM knobs & cost controls
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_EFFORT=high
LLM_MAX_TOKENS=4096
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_CALLS_PER_REQUEST=10
LLM_TIMEOUT_SECONDS=30.0
LLM_REFUSAL_FALLBACKS=true
LLM_MAX_RETRIES=2
LLM_RETRY_FALLBACK_MODEL=llama-3.1-8b-instant

# ---------- Vector Store (Qdrant) ----------
# Leave QDRANT_URL empty to use the embedded local store at QDRANT_PATH (no Docker needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=k8s_ops_bge_small
# If true, falls back to baseline 'k8s_ops' if configured collection is missing.
# If false (default), raises a clear RuntimeError to prevent accidental silent degradation.
ALLOW_COLLECTION_FALLBACK=false

# ---------- Embeddings & Reranking ----------
# fastembed = local CPU ONNX dense (384d) + local BM25 + cross-encoder reranker
# keyword   = pure-Python BM25 only; zero downloads, no dense arm, lexical reranking
# gemini    = dense via Gemini API + sparse via local BM25
# auto      = try fastembed, fall back to keyword if ONNX cannot be loaded
RETRIEVAL_BACKEND=fastembed
DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
SPARSE_MODEL=local-bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# FastEmbed ONNX model cache directory (optional)
MODEL_CACHE_DIR=
# Hugging Face token for model downloads if rate-limited (optional)
HF_TOKEN=

# ---------- Text2SQL Store (PostgreSQL / SQLite) ----------
# In local development:
#   Leave POSTGRES_DSN empty to fall back to a local SQLite file at data/ops.db.
#   Or use Docker Compose where it defaults to postgres:postgres.
#
# In production (APP_ENV=production):
#   POSTGRES_DSN is strictly required. Supported synchronous drivers are
#   'postgresql+psycopg', 'postgresql+psycopg2', and 'postgresql' (asyncpg is rejected).
#   SQLite fallbacks, missing passwords, passwords under 16 characters, and
#   insecure defaults/placeholders ('postgres', 'password', 'changeme', etc.)
#   are strictly rejected at startup. Passwords with special characters should be
#   URL-encoded (e.g. %40 for @).
#
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ops
POSTGRES_DSN=
# Production example:
# POSTGRES_DSN=postgresql+psycopg://sre_user:MustBe16CharsOrLongerSecret99!@pg.internal:5432/ops
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SECONDS=15

# ---------- LangGraph State Persistence ----------
# memory | postgres
CHECKPOINT_BACKEND=memory

# ---------- Cache ----------
# Leave empty to use in-process cache instead of Redis.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- Retrieval Tuning ----------
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
HYBRID_DENSE_WEIGHT=0.7
CRAG_RELEVANCE_FLOOR=0.25
SELF_RAG_MAX_RETRIES=1

# ---------- Pipeline Feature Flags ----------
ENABLE_HYDE=true
ENABLE_CRAG=true
ENABLE_SELF_RAG=true
ENABLE_TEXT2SQL=true
ENABLE_GUARDRAILS=true
ENABLE_CACHE=true

# ---------- FastAPI & Server ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
